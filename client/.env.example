# Where the Vite dev/preview server proxies /api requests (the Express server)
VITE_API_TARGET=http://localhost:5000

# Production builds hosted without an /api proxy (e.g. Hostinger): the API's origin,
# called directly. Leave empty to use same-origin /api. The API must allow the
# site's origin in CORS, and be on the same site for its SameSite=Strict cookies.
VITE_API_BASE_URL=

# Where "Contact support" opens a mail draft (customer pages); the button is disabled when empty
VITE_SUPPORT_EMAIL=info@nanoveu.com
