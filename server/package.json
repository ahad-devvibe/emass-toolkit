{
  "name": "emass-toolkit",
  "version": "1.0.0",
  "description": "Layered Express/Prisma/PostgreSQL backend starter with a scaffold CLI",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "dotenv -e .env.test -- vitest run",
    "test:integration": "dotenv -e .env.test -- vitest run tests/integration",
    "test:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "docs:spec": "tsx scripts/generate-openapi.ts",
    "docs:html": "redocly build-docs docs/api/openapi.json -o docs/api/index.html",
    "docs": "npm run docs:spec && npm run docs:html",
    "seed:domains": "tsx scripts/seed-domains.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "email:preview": "tsx scripts/preview-emails.ts",
    "hubspot:setup": "tsx scripts/setup-hubspot.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "node-fetch": "^2.7.0",
    "oci-common": "^2.139.1",
    "oci-emaildataplane": "^2.139.1",
    "oci-objectstorage": "^2.143.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "svg-captcha": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.46.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.10"
  }
}
