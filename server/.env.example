PORT=5000
DATABASE_URL="postgresql://user:pass@localhost:5432/emass-toolkit"
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Auth ---
JWT_SECRET=change-me-64-hex-chars
# Frontend origin used to build set-password links
APP_BASE_URL=http://localhost:5173
# Set-password link lifetime and reminder offset (hours)
SET_PASSWORD_TTL_HOURS=48
SET_PASSWORD_REMINDER_HOURS=24
# Captcha cookie lifetime (seconds)
CAPTCHA_TTL_SECONDS=600

# --- Email (console | oci) ---
# console logs OTP / password-reset emails to stdout (dev default).
# oci sends through OCI Email Delivery.
EMAIL_PROVIDER=console
# Required when EMAIL_PROVIDER=oci — must be an approved sender in the same region as OCI_REGION.
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=EMASS Toolkit

# --- Shared OCI auth (email-oci + storage): config-file | instance-principal ---
OCI_REGION=your-oci-region
OCI_AUTH_MODE=config-file
# Absolute path to a project-local OCI config file, or leave empty to use ~/.oci/config.
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT
# Required when EMAIL_PROVIDER=oci — compartment that contains the approved sender.
OCI_COMPARTMENT_ID=your-oci-compartment-ocid

# --- Object storage (bucket stays private; downloads use short-lived PARs) ---
# The namespace is the tenancy's object-storage namespace (not the tenancy OCID).
OCI_OBJECT_NAMESPACE=your-object-storage-namespace
OCI_BUCKET=your-bucket
# Prod only: separate staging and release buckets (both default to OCI_BUCKET).
OCI_STAGING_BUCKET=
OCI_RELEASE_BUCKET=

# --- Release file storage ---
# local writes to STORAGE_LOCAL_DIR (dev/tests, no cloud needed); oci uses the
# buckets above. Production refuses to boot unless this is oci.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.tmp/storage
# Per-file cap (1 GiB) and OCI multipart part size (min 10 MiB).
MAX_UPLOAD_BYTES=1073741824
UPLOAD_PART_BYTES=10485760
# Server-wide request timeout (2 h) so large uploads aren't cut off.
UPLOAD_TIMEOUT_MS=7200000
# Publish copies staging -> release; how long one file copy may take (30 min)
COPY_TIMEOUT_MS=1800000
# How often to poll an OCI copy work request for progress
COPY_POLL_MS=1000
# How long a finished publish job stays readable for the admin dialog (10 min)
PUBLISH_JOB_TTL_MS=600000
# How long a download link works after the click (seconds, 60-86400)
DOWNLOAD_URL_TTL_SECONDS=3600
# Staff links to unpublished (staged) files (seconds, 60-3600)
STAGED_DOWNLOAD_URL_TTL_SECONDS=300

# Reverse proxies in front of the API (1 behind nginx), so sign-in logs record
# the client's IP; 0 trusts none
TRUST_PROXY=0

# --- HubSpot (one-way customer contact sync on account activation) ---
HUBSPOT_ENABLED=false
# Required when HUBSPOT_ENABLED=true — private-app token. Scopes: crm.objects.contacts.write
# (runtime sync) + crm.schemas.contacts.write (only for `npm run hubspot:setup`).
HUBSPOT_API_KEY=
