generator client {
  provider        = "prisma-client-js"
  // EmailOutbox's due index covers only rows still to send
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum OtpPurpose {
  MFA_LOGIN
  PASSWORD_RESET
  // Signup: proves the person owns the inbox before they set a password
  SIGNUP_VERIFY
}

enum UserRole {
  CUSTOMER
  DEV
  ADMIN
}

enum UserStatus {
  PENDING_APPROVAL
  PENDING_SET_PASSWORD
  ACTIVE
  BLOCKED
}

// Why an account is BLOCKED, so the dashboard can tell them apart
enum BlockReason {
  COMPETITOR_DOMAIN
  SIGNUP_REJECTED
}

enum AuthEventType {
  SIGN_IN_SUCCEEDED
  SIGN_IN_FAILED
  PASSWORD_RESET
}

enum EmailDomainKind {
  FREE_MAIL
  COMPETITOR
}

model User {
  id String @id @default(uuid())

  email       String  @unique
  firstName   String
  middleName  String?
  lastName    String
  country     String
  companyName String
  jobTitle    String
  // What they told us at sign-up they will use EMASS for (null for older accounts)
  useCase     String? @db.Text
  website     String?

  password String?

  emailVerified Boolean    @default(false)
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(PENDING_SET_PASSWORD)

  // HubSpot contact record ID (numeric string), filled by the best-effort sync;
  // null until the first successful upsert. Internal only, never sent to clients.
  hubspotContactId String?   @unique
  hubspotSyncedAt  DateTime?

  rejectionReason        String?      @db.Text
  blockReason            BlockReason?
  // Download licence click-through (customers, once): when and which wording
  licenseAcceptedAt      DateTime?
  licenseVersion         String?
  // Customer download totals, kept in step with Download rows (same
  // transaction) so HubSpot sync reads one row instead of aggregating
  downloadCount          Int          @default(0)
  firstDownloadAt        DateTime?
  firstDownloadLabel     String?
  lastDownloadAt         DateTime?
  lastDownloadLabel      String?
  // HubSpot sync progress: the count HubSpot last received, and the note
  hubspotSyncedDownloads Int          @default(0)
  hubspotNoteSentAt      DateTime?

  refreshTokens       RefreshToken[]
  otps                Otp[]
  setPasswordTokens   SetPasswordToken[]
  passwordResetTokens PasswordResetToken[]
  authEvents          AuthEvent[]
  downloads           Download[]
  activity            ActivityLog[]
  emailOutbox         EmailOutbox[]

  releasesCreated   Release[]         @relation("ReleaseCreatedBy")
  releasesPublished Release[]         @relation("ReleasePublishedBy")
  uploadSessions    UploadSession[]
  releaseEvents     ReleaseEvent[]
  resourcesUpdated  ProductResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Otp {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
}

model SetPasswordToken {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  expiresAt      DateTime
  reminderSentAt DateTime?
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

// Forgot-password links: one live token per user (a new request replaces the
// old one). Only the sha256 of the raw token is stored; the raw token exists
// only in the emailed link.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Append-only sign-in audit trail. userId is null for unknown emails and
// survives (as null) if the user is deleted.
model AuthEvent {
  id        String        @id @default(uuid())
  type      AuthEventType
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  // The ApiError code of a failed attempt, e.g. INVALID_CREDENTIALS
  code      String?
  ip        String?
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
}

model EmailDomainPolicy {
  id        String          @id @default(uuid())
  domain    String          @unique
  kind      EmailDomainKind
  createdAt DateTime        @default(now())
}

// ---------------------------------------------------------------------------
// Catalog + releases (see tasks/release-management.md).
// Products are seeded (npm run seed:products, fixed ids); admin CRUD comes later.

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  detail      String? @db.Text
  imageUrl    String?
  sortOrder   Int     @default(0)

  isActive Boolean @default(true)

  releases  Release[]
  resources ProductResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

enum ReleaseStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  PUBLISHED
  ARCHIVED
  ROLLED_BACK
}

enum ReleaseFileKind {
  SDK
  DOC
}

// Detected from a file's first bytes: installers (PE, DEB, PKG) get the
// strict checks; PDF and OTHER follow the doc rules
enum ReleaseFileFormat {
  PE
  DEB
  PKG
  PDF
  OTHER
}

enum SdkPlatform {
  WINDOWS
  MACOS
  UBUNTU
}

enum ReleaseEventType {
  CREATED
  SUBMITTED
  WITHDRAWN
  CHANGES_REQUESTED
  PUBLISHED
  ARCHIVED
  ROLLED_BACK
  RESTORED
  NOTES_EDITED
  // Rollback emails went out to customers who downloaded the release
  CUSTOMERS_NOTIFIED
}

model Release {
  id           String        @id @default(uuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  version      String
  // Parsed semver parts, for ordering and "newer than shipped" checks
  versionMajor Int
  versionMinor Int
  versionPatch Int
  status       ReleaseStatus @default(DRAFT)

  releaseNotes String @default("") @db.Text

  createdById String
  createdBy   User   @relation("ReleaseCreatedBy", fields: [createdById], references: [id])

  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation("ReleasePublishedBy", fields: [publishedById], references: [id])

  files    ReleaseFile[]
  events   ReleaseEvent[]
  uploads  UploadSession[]
  activity ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, version])
  @@index([productId, status])
  @@index([status, createdAt])
  @@index([productId, publishedAt])
}

model ReleaseFile {
  id        String           @id @default(uuid())
  releaseId String
  release   Release          @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  // Null while drafting: the file uploaded before anyone picked its type.
  // Submit requires a kind on every file (and a platform on every SDK).
  kind      ReleaseFileKind?

  platform SdkPlatform?

  originalName String
  contentType  String
  sizeBytes    BigInt
  sha256       String
  // staged/... until publish, then releases/...; never overwritten
  objectKey    String @unique

  // What the file-inspect parser found when it was uploaded (null for files
  // uploaded before inspection existed); re-checked when the version changes
  format           ReleaseFileFormat?
  detectedVersions String[]           @default([])

  downloads Download[]
  activity  ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([releaseId, platform])
  // The same bytes never appear twice in one release
  @@unique([releaseId, sha256])
  // Installer checks look up identical bytes in other releases
  @@index([sha256])
}

// A release file arriving piece by piece (POST /releases/:id/uploads). Parts
// come in order, so the server hashes as they arrive; hashState is hash-wasm's
// saved SHA-256 state, so the whole-file hash survives restarts. The row is
// deleted when the file is saved, aborted, or untouched for 24 h.
model UploadSession {
  id          String  @id @default(uuid())
  releaseId   String
  release     Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id])

  // The staged object being written, and the storage multipart upload id
  objectKey       String @unique
  storageUploadId String

  fileName       String
  contentType    String
  sizeBytes      BigInt
  partSize       Int
  partsDone      Int    @default(0)
  // { "<part number>": "<etag>" }, committed in order on complete
  etags          Json   @default("{}")
  hashState      Bytes
  declaredSha256 String

  kind          ReleaseFileKind?
  platform      SdkPlatform?
  replaceFileId String?

  // Set while one request completes the upload, so a second complete can't
  // race it; a stale claim (crashed request) expires
  completingAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Creating the same file again returns this session: that's how a client
  // that lost the session id resumes
  @@unique([releaseId, declaredSha256])
  // Stale sessions are found by age
  @@index([updatedAt])
}

model ReleaseEvent {
  id        String           @id @default(uuid())
  releaseId String
  release   Release          @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  type      ReleaseEventType
  actorId   String
  actor     User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  note      String?          @db.Text
  createdAt DateTime         @default(now())

  @@index([releaseId, createdAt])
}

model ProductResource {
  id           String  @id @default(uuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title        String
  originalName String
  contentType  String
  sizeBytes    BigInt
  sha256       String
  objectKey    String  @unique

  updatedById String
  updatedBy   User   @relation(fields: [updatedById], references: [id])

  downloads Download[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// One row per authorized download click (cookie-authenticated; the server
// checks access, then issues a read-only object PAR, ~1 hour). One of
// releaseFileId / resourceId is set; both become null if the file is deleted.
model Download {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  releaseFileId String?
  releaseFile   ReleaseFile?     @relation(fields: [releaseFileId], references: [id], onDelete: SetNull)
  resourceId    String?
  resource      ProductResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  // Denormalized so rollback recipients are one indexed query
  releaseId     String?
  createdAt     DateTime         @default(now())

  @@index([releaseId, userId])
  @@index([userId, createdAt])
}

enum ActivityAction {
  FILE_DOWNLOADED
}

// Staff actions worth keeping (for now: staff downloading release files).
// Customer downloads go to Download, which stays customers-only.
model ActivityLog {
  id            String         @id @default(uuid())
  actorId       String
  actor         User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action        ActivityAction
  // Kept loose: a deleted draft or file leaves the log row with nulls
  releaseId     String?
  release       Release?       @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  releaseFileId String?
  releaseFile   ReleaseFile?   @relation(fields: [releaseFileId], references: [id], onDelete: SetNull)
  // e.g. { fileName, staged }
  details       Json?
  createdAt     DateTime       @default(now())

  @@index([actorId, createdAt])
  @@index([releaseId, createdAt])
}

enum EmailKind {
  // Rollback notice to everyone who downloaded the withdrawn release
  RELEASE_WITHDRAWN
  // New-release announcement (later task)
  RELEASE_ANNOUNCED
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// Bulk mail queue: one row per recipient, written in the same transaction as
// the event that causes it and sent at a set pace by the in-process worker.
// Sent rows are kept as the record of who was emailed.
model EmailOutbox {
  id            String      @id @default(uuid())
  kind          EmailKind
  // Lower goes first: 0 = rollback notice, 10 = announcement
  priority      Int         @default(10)
  // The causing event's id (the ROLLED_BACK event for rollbacks); no FK, as
  // announcement batches won't come from a ReleaseEvent
  batchId       String
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  toEmail       String
  // Template input: firstName, product, versions, url, message
  payload       Json
  status        EmailStatus @default(PENDING)
  // Counted when a worker claims the row, so a send that crashes the process also runs out
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  // A claiming worker's lease; another worker may re-claim the row once it passes
  lockedUntil   DateTime?
  lastError     String?     @db.Text
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  // Re-running an enqueue can't queue anyone twice
  @@unique([batchId, toEmail])
  @@index([batchId, status])
  // Rolling 24 h daily cap
  @@index([sentAt])
  // Claims read only the rows still to send, however many are SENT. The
  // condition is written as Postgres stores it (IN becomes = ANY): Prisma
  // compares the text, and any other spelling makes migrate dev re-create it
  @@index([priority, createdAt], map: "EmailOutbox_due_idx", where: raw("(status = ANY (ARRAY['PENDING'::\"EmailStatus\", 'SENDING'::\"EmailStatus\"]))"))
}

