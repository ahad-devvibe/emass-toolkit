generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OtpPurpose {
  MFA_LOGIN
  PASSWORD_RESET
  // Signup: proves the person owns the inbox before they set a password
  SIGNUP_VERIFY
}

enum UserRole {
  CUSTOMER
  DEV
  ADMIN
}

enum UserStatus {
  PENDING_APPROVAL
  PENDING_SET_PASSWORD
  ACTIVE
  BLOCKED
}

enum EmailDomainKind {
  FREE_MAIL
  COMPETITOR
}

model User {
  id String @id @default(uuid())

  email       String  @unique
  firstName   String
  middleName  String?
  lastName    String
  country     String
  companyName String
  jobTitle    String

  password String?

  emailVerified Boolean    @default(false)
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(PENDING_SET_PASSWORD)

  // HubSpot contact record ID (numeric string), filled by the best-effort sync;
  // null until the first successful upsert. Internal only, never sent to clients.
  hubspotContactId String?   @unique
  hubspotSyncedAt  DateTime?

  rejectionReason String? @db.Text

  refreshTokens     RefreshToken[]
  otps              Otp[]
  setPasswordTokens SetPasswordToken[]

  releasesCreated   Release[]         @relation("ReleaseCreatedBy")
  releasesPublished Release[]         @relation("ReleasePublishedBy")
  releaseEvents     ReleaseEvent[]
  resourcesUpdated  ProductResource[]
  // downloads         Download[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Otp {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
}

model SetPasswordToken {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  expiresAt      DateTime
  reminderSentAt DateTime?
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model EmailDomainPolicy {
  id        String          @id @default(uuid())
  domain    String          @unique
  kind      EmailDomainKind
  createdAt DateTime        @default(now())
}

// ---------------------------------------------------------------------------
// Catalog + releases (see tasks/release-management.md).
// Products are seeded (npm run seed:products, fixed ids); admin CRUD comes later.

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  detail      String? @db.Text
  imageUrl    String?
  sortOrder   Int     @default(0)

  isActive Boolean @default(true)

  releases  Release[]
  resources ProductResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

enum ReleaseStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  PUBLISHED
  ARCHIVED
  ROLLED_BACK
}

enum ReleaseFileKind {
  SDK
  DOC
}

enum SdkPlatform {
  WINDOWS
  MACOS
  UBUNTU
}

enum ReleaseEventType {
  CREATED
  SUBMITTED
  WITHDRAWN
  CHANGES_REQUESTED
  PUBLISHED
  ARCHIVED
  ROLLED_BACK
  RESTORED
  NOTES_EDITED
}

model Release {
  id           String        @id @default(uuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  version      String
  // Parsed semver parts, for ordering and "newer than shipped" checks
  versionMajor Int
  versionMinor Int
  versionPatch Int
  status       ReleaseStatus @default(DRAFT)

  releaseNotes String @default("") @db.Text

  createdById String
  createdBy   User   @relation("ReleaseCreatedBy", fields: [createdById], references: [id])

  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation("ReleasePublishedBy", fields: [publishedById], references: [id])

  files  ReleaseFile[]
  events ReleaseEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, version])
  @@index([productId, status])
  @@index([status, createdAt])
  @@index([productId, publishedAt])
}

model ReleaseFile {
  id        String          @id @default(uuid())
  releaseId String
  release   Release          @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  // Null while drafting: the file uploaded before anyone picked its type.
  // Submit requires a kind on every file (and a platform on every SDK).
  kind      ReleaseFileKind?

  platform SdkPlatform?

  originalName String
  contentType  String
  sizeBytes    BigInt
  sha256       String
  // staged/... until publish, then releases/...; never overwritten
  objectKey    String @unique

  // downloads Download[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([releaseId, platform])
}

model ReleaseEvent {
  id        String           @id @default(uuid())
  releaseId String
  release   Release          @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  type      ReleaseEventType
  actorId   String
  actor     User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  note      String?          @db.Text
  createdAt DateTime         @default(now())

  @@index([releaseId, createdAt])
}

model ProductResource {
  id           String  @id @default(uuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title        String
  originalName String
  contentType  String
  sizeBytes    BigInt
  sha256       String
  objectKey    String  @unique

  updatedById String
  updatedBy   User   @relation(fields: [updatedById], references: [id])

  // downloads Download[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

